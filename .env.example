# ===== Cloudflare R2 对象存储（S3 兼容，零依赖 SigV4）=====
# 在 R2 控制台的「API 令牌」中获取；不配置时 putObject/deleteObject 会明确报错而非静默失败。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=next-starter
# 可选：自定义 R2 公开访问域名（r2.dev 或自定义域），默认回退到 r2.dev 公网地址
R2_PUBLIC_BASE_URL=

# ===== 数据库（Turso / libsql + better-sqlite3）=====
# 本地开发：留空 -> 连 ./local.db（better-sqlite3）
# Vercel 生产：填入 Turso 连接串与令牌 -> 连 @libsql 远端
# 建议在本文件以注释形式保留（# TURSO_DATABASE_URL=...），避免本地 dev 误连线上库；
# *:prod 脚本会从注释行中解析并注入。
# TURSO_DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# ===== 服务端模板目录 =====
# 模板接口已迁移到本项目 /api/xcx/resume-templates，读取当前 Turso 的 resume_templates。
# 如果以后仍需要从外部模板服务同步/代理，可单独配置同步任务；页面不再依赖此变量。
# TEMPLATE_STORE_API_BASE_URL=
# TEMPLATE_STORE_AUTH_TOKEN=

# ===== 大模型（OpenAI 兼容，多 provider）=====
# 可选值：qwen | deepseek | glm | openai-compatible（默认 qwen）
LLM_PROVIDER=qwen
# 通用 key/base（缺省时回退 QWEN_*）
LLM_API_KEY=
LLM_BASE_URL=
# 模型名【无代码默认值】：必须显式配置，缺失时调用直接报错，防误用付费模型扣费
LLM_MODEL=
# 强模型（重写/校验场景，缺省回退 LLM_MODEL）
LLM_STRONG_MODEL=
# 各平台兜底 key/base（LLM_PROVIDER=qwen 时生效）
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# ===== 简历会员价格后台 =====
# ai-writer 服务地址（例如 https://www.xiaoguamanhua.asia）。
# 配置后优先读取后台「简历会员配置」，不可达时回退站内默认价格。
RESUME_MEMBERSHIP_API_BASE=

# ===== 鉴权（cookie-session HMAC 签名密钥）=====
# 生产务必替换为随机长串；留空时使用内置不安全默认值并告警
AUTH_SECRET=
